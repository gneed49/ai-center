{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI Center",
  "version": "0.1.0",
  "identifier": "com.aicenter.client",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @ai-center/web",
    "beforeBuildCommand": "npm run build -w @ai-center/web"
  },
  "app": {
    "windows": [
      {
        "title": "AI Center",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4317 http://localhost:4317 http://10.0.2.2:4317; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
