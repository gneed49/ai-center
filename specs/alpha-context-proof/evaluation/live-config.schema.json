{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-center.local/schemas/alpha-context-proof/live-config.schema.json",
  "title": "Private Alpha Context Proof live runner configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "pricing_version",
    "pricing_verified_at",
    "models",
    "selected_model",
    "calibration_case_ids",
    "reserve_case_ids",
    "max_output_tokens",
    "request_overhead_tokens",
    "timeout_seconds",
    "frozen_contract",
    "instability_rules",
    "reserve_justifications"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign_id": {
      "type": "string",
      "minLength": 3
    },
    "pricing_version": {
      "type": "string",
      "minLength": 1
    },
    "pricing_verified_at": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input_usd_per_million", "output_usd_per_million"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input_usd_per_million": { "type": ["number", "string"] },
          "output_usd_per_million": { "type": ["number", "string"] }
        }
      }
    },
    "selected_model": { "type": ["string", "null"] },
    "calibration_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "reserve_case_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 64,
      "maximum": 20000
    },
    "request_overhead_tokens": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 20000
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 300
    },
    "frozen_contract": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_model",
            "runner_version",
            "prompt_version",
            "output_schema_version",
            "calibration_runs_hash",
            "frozen_at",
            "campaign_hash",
            "execution_config_hash",
            "private_cases_hash"
          ],
          "properties": {
            "selected_model": { "type": "string" },
            "runner_version": { "const": "1.2.0" },
            "prompt_version": { "const": "alpha-context-proof-live-v2" },
            "output_schema_version": { "const": "alpha-context-proof-live-v2" },
            "calibration_runs_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "frozen_at": {
              "type": "string",
              "format": "date-time"
            },
            "campaign_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "execution_config_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "private_cases_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "instability_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["quality_metrics_vary", "predicted_labels_vary"] }
    },
    "reserve_justifications": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "main_runs_hash"],
        "properties": {
          "rule": { "enum": ["quality_metrics_vary", "predicted_labels_vary"] },
          "main_runs_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
