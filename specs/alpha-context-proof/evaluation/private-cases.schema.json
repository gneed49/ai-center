{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-center.local/schemas/alpha-context-proof/private-cases.schema.json",
  "title": "Private live-eval case payloads",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "handoffs", "contradictions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign_id": { "type": "string" },
    "handoffs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_text", "conditions"],
        "properties": {
          "task_text": { "type": "string", "minLength": 1 },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context_pack", "full_dump"],
            "properties": {
              "context_pack": { "$ref": "#/$defs/condition" },
              "full_dump": { "$ref": "#/$defs/condition" }
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["left", "right"],
        "properties": {
          "left": { "$ref": "#/$defs/source" },
          "right": { "$ref": "#/$defs/source" }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "allowed_source_ids", "context_pack_hash"],
      "properties": {
        "payload": {},
        "allowed_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "context_pack_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "text"],
      "properties": {
        "version_id": { "type": "string", "format": "uuid" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
