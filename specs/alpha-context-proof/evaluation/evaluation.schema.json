{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-center.local/schemas/alpha-context-proof/evaluation.schema.json",
  "title": "Blind handoff comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "comparison_id",
    "task_id",
    "repetition",
    "context_pack_run_id",
    "full_dump_run_id",
    "evaluator_ref",
    "evaluator_role",
    "blind_preference",
    "context_pack_without_major_reformulation"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evaluation_id": { "type": "string", "minLength": 3 },
    "comparison_id": { "type": "string", "minLength": 3 },
    "task_id": { "type": "string", "pattern": "^handoff-[0-9]{2}$" },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 5 },
    "context_pack_run_id": { "type": "string" },
    "full_dump_run_id": { "type": "string" },
    "evaluator_ref": { "type": "string", "minLength": 3 },
    "evaluator_role": { "enum": ["owner", "secondary"] },
    "blind_preference": { "enum": ["context_pack", "full_dump", "tie"] },
    "context_pack_without_major_reformulation": { "type": "boolean" }
  }
}
