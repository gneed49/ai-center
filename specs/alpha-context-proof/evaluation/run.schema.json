{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-center.local/schemas/alpha-context-proof/run.schema.json",
  "title": "Expurgated model run metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_kind",
    "case_id",
    "project_ref",
    "stage",
    "condition",
    "repetition",
    "model",
    "prompt_version",
    "output_schema_version",
    "input_tokens",
    "latency_ms",
    "cost_usd",
    "structured_output_valid",
    "source_ids_valid",
    "runner_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "runner_version": { "const": "1.1.0" },
    "run_id": { "type": "string", "minLength": 3 },
    "case_kind": { "enum": ["handoff", "contradiction"] },
    "case_id": { "type": "string" },
    "project_ref": { "type": "string" },
    "stage": { "enum": ["calibration", "main", "reserve"] },
    "condition": { "enum": ["context_pack", "full_dump"] },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 5 },
    "model": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "output_schema_version": { "type": "string", "minLength": 1 },
    "context_pack_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_tokens": { "type": "integer", "minimum": 1 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "structured_output_valid": { "type": "boolean" },
    "source_ids_valid": { "type": "boolean" },
    "attempts": { "const": 1 },
    "provider_status": { "type": "string", "minLength": 1 },
    "provider_response_ref": { "type": "string", "minLength": 1 },
    "request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "critical_facts_expected": { "type": "integer", "minimum": 0 },
    "critical_facts_present": { "type": "integer", "minimum": 0 },
    "relevant_items_expected": { "type": "integer", "minimum": 0 },
    "relevant_items_present": { "type": "integer", "minimum": 0 },
    "selected_items_total": { "type": "integer", "minimum": 0 },
    "irrelevant_items_selected": { "type": "integer", "minimum": 0 },
    "expected_label": { "enum": ["contradiction", "compatible", "ambiguous"] },
    "predicted_label": { "enum": ["contradiction", "compatible", "ambiguous"] }
  }
}
