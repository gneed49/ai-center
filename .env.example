# Server
AI_CENTER_BIND=127.0.0.1:4317
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
AI_CENTER_WORKSPACE_ID=10000000-0000-0000-0000-000000000001
AI_CENTER_ACTOR_ID=00000000-0000-0000-0000-000000000001

# Agent engine (server only)
OPENAI_API_KEY=
# Set both explicitly only for an approved live-evaluation run.
OPENAI_MODEL=
AI_CENTER_AGENT_MODE=deterministic

# Authentication. Local mode is loopback-only; private alpha uses supabase.
AI_CENTER_AUTH_MODE=local
SUPABASE_URL=
AI_CENTER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Optional private alpha GitHub App (strictly read-only)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Web client (public)
VITE_API_URL=http://127.0.0.1:4317
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Personal provider credentials are entered in the app, never in VITE_*.
# Local loopback: a private 0600 key is generated under .run/provider-credentials/.
# Shared server: set exactly 64 random hexadecimal characters (32 bytes) privately.
# AI_CENTER_CREDENTIAL_ENCRYPTION_KEY=

# Claude subscription uses the installed official client on local Linux only.
# Local default: detect the installed client and verify its isolation capabilities.
# AI_CENTER_SUBSCRIPTIONS_ENABLED=false
# Optional absolute override (otherwise resolve installed claude from absolute PATH directories):
# AI_CENTER_CLAUDE_EXECUTABLE=/absolute/path/to/claude
# Optional absolute private directory (default .run/provider-subscriptions):
# AI_CENTER_SUBSCRIPTIONS_DIRECTORY=/absolute/private/path

# Private-instance bootstrap: UUIDs of operators allowed to create a first company.
# Accepted existing owners can also create companies, within the per-actor cap.
# AI_CENTER_COMPANY_CREATORS=
# Effective per-company logical model-call limits (provider retry attempts remain bounded separately).
# AI_CENTER_AI_CALLS_PER_HOUR=120
# AI_CENTER_AI_ACTOR_CALLS_PER_HOUR=60
# AI_CENTER_AI_ACTOR_CONCURRENT_CALLS=2
# AI_CENTER_AI_CONCURRENT_CALLS=4
# AI_CENTER_AI_CALL_TIMEOUT_SECONDS=120
