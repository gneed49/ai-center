# Server
AI_CENTER_BIND=127.0.0.1:4317
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
AI_CENTER_WORKSPACE_ID=10000000-0000-0000-0000-000000000001
AI_CENTER_ACTOR_ID=00000000-0000-0000-0000-000000000001

# Agent engine (server only)
OPENAI_API_KEY=
# Set both explicitly only for an approved live-evaluation run.
OPENAI_MODEL=
AI_CENTER_AGENT_MODE=deterministic

# Authentication. Local mode is loopback-only; private alpha uses supabase.
AI_CENTER_AUTH_MODE=local
SUPABASE_URL=
AI_CENTER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Optional private alpha GitHub App (strictly read-only)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Web client (public)
VITE_API_URL=http://127.0.0.1:4317
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
